---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogType?: string;
}
const { title, description, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Search results cut titles at ~60 characters: only add the brand suffix if it fits.
const fullTitle =
  title === 'Killflare'
    ? 'Killflare — Wildfire Home Defense Supplies, Reviewed'
    : `${title} · Killflare`.length <= 60 ? `${title} · Killflare` : title;
// Meta descriptions are truncated past ~160 characters: cut at the last full
// sentence that fits, else at a word boundary with an ellipsis.
function clampDescription(d: string, max = 160): string {
  const t = d.replace(/\s+/g, ' ').trim();
  if (t.length <= max) return t;
  const cut = t.slice(0, max);
  // Last sentence end that isn't an abbreviation like "Dept." or "St.".
  const ends = [...cut.matchAll(/(\S+)[.!?](?=\s|$)/g)].filter(
    (m) => !/^(Dept|St|Mt|No|Inc|Ltd|Co|Corp|vs|etc|approx|e\.g|i\.e|U\.S|[A-Z])$/i.test(m[1]),
  );
  const last = ends.at(-1);
  if (last && last.index! + last[0].length >= 70) return cut.slice(0, last.index! + last[0].length);
  return cut.replace(/[\s,;:—–-]+\S*$/, '') + '…';
}
const metaDescription = clampDescription(description);

// Sitewide identity. Page-level Article/Product/Place schemas stay where they
// are and reference this Organization by @id.
const siteLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': new URL('/#organization', Astro.site).href,
      name: 'Killflare',
      url: new URL('/', Astro.site).href,
      logo: new URL('/og-default.png', Astro.site).href,
      description: 'Wildfire home defense supplies, reviewed — ember-resistant gear, defensible space tools and alerts.',
    },
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', Astro.site).href,
      name: 'Killflare',
      url: new URL('/', Astro.site).href,
      inLanguage: 'en',
      publisher: { '@id': new URL('/#organization', Astro.site).href },
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Killflare" />
    <meta property="og:image" content={new URL('/og-default.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og-default.png', Astro.site)} />
    <meta name="theme-color" content="#d8460d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;1,14..32,400&family=IBM+Plex+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
