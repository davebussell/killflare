---
import Base from '../../layouts/Base.astro';
import CatIcon from '../../components/CatIcon.astro';
import regions from '../../data/regions.json';
import categories from '../../data/categories.json';
import installers from '../../data/installers.json';

export function getStaticPaths() {
  return regions.map((r) => ({ params: { slug: r.slug }, props: { r } }));
}
const { r } = Astro.props;
const cats = r.priorities.map((s: string) => categories.find((c) => c.slug === s)).filter(Boolean);
const progs = installers.programs.filter((p: any) => p.province === r.code);
const cos = installers.companies.filter((c: any) => c.provinces.includes(r.code));
const others = regions.filter((x) => x.slug !== r.slug);
const riskClass = r.risk.toLowerCase().replace(' ', '-');
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: `Wildfire preparedness in ${r.name}`,
  description: r.lede,
  about: { '@type': 'Place', name: r.name },
  publisher: { '@type': 'Organization', name: 'Killflare' },
};
---
<Base title={`${r.name} wildfire guide`} description={`Wildfire preparedness for ${r.name}: fire season, fuel types, recent fires, ${r.program.name}, and the gear that matters most locally.`} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class={`reg risk-${riskClass}`}>
    <div class="wrap">
      <nav class="crumb mono" aria-label="Breadcrumb"><a href="/regions/">Regions</a> / {r.code}</nav>

      <header class="reg__head">
        <div>
          <span class="reg__risk mono">{r.risk} risk · {r.riskNote}</span>
          <h1>{r.name}</h1>
          <p class="reg__lede">{r.lede}</p>
        </div>
        <dl class="reg__facts mono">
          <div><dt>Fire season</dt><dd>{r.season}</dd></div>
          <div><dt>Dominant fuel</dt><dd>{r.fuel}</dd></div>
          {r.burned2025 !== '—' && <div><dt>Burned 2025</dt><dd>{r.burned2025}</dd></div>}
          {r.burned2023 !== '—' && <div><dt>Burned 2023</dt><dd>{r.burned2023}</dd></div>}
          <div><dt>Fire agency</dt><dd><a href={r.agency.url} rel="noopener" target="_blank">{r.agency.name}</a></dd></div>
        </dl>
      </header>

      <div class="reg__body">
        <nav class="toc" aria-label="Sections">
          <span class="eyebrow">In this guide</span>
          <ol>{r.sections.map((s: any, i: number) => <li><a href={`#s${i}`}>{s.heading}</a></li>)}</ol>
        </nav>
        <div class="prose reg__prose">
          {r.sections.map((s: any, i: number) => (
            <section id={`s${i}`}>
              <h2>{s.heading}</h2>
              <p>{s.body}</p>
            </section>
          ))}
        </div>
      </div>
    </div>
  </article>

  <section class="section section--tight">
    <div class="wrap">
      <div class="section-head"><h2>Gear that matters most in {r.short}</h2><p>Ordered by what we'd buy first here.</p></div>
      <div class="grid grid--3">
        {cats.map((c: any, i: number) => (
          <a href={`/categories/${c.slug}/`} class={`card pcard zone-${c.zone}`}>
            <span class="pcard__n mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="pcard__icon"><CatIcon name={c.icon} size={26} /></span>
            <h3>{c.name}</h3>
            <p>{c.tagline}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="section-head"><h2>Official programs in {r.short}</h2></div>
      {progs.length > 0 ? (
        <ul class="progs">
          {progs.map((p: any) => (
            <li>
              <a href={p.url} rel="noopener" target="_blank">{p.name} ↗</a>
              <p>{p.note}</p>
            </li>
          ))}
        </ul>
      ) : <p class="muted">No province-specific program listed.</p>}
      {cos.length > 0 && (
        <p class="progs__more">
          {cos.length} {cos.length === 1 ? 'company serves' : 'companies serve'} {r.short} —
          <a href={`/install/#${r.code.toLowerCase()}`}> see the installer directory</a>.
        </p>
      )}
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="section-head"><h2>Other regions</h2></div>
      <ul class="reglist">
        {others.map((o) => <li><a href={`/regions/${o.slug}/`}><span class="mono">{o.code}</span> {o.name}</a></li>)}
      </ul>
    </div>
  </section>
</Base>
<style>
  .reg { padding-block: clamp(2rem, 5vw, 3.5rem) 1rem; --rk: var(--ink-3); }
  .reg.risk-extreme { --rk: var(--ember); }
  .reg.risk-high { --rk: var(--amber); }
  .reg.risk-moderate { --rk: var(--moss); }
  .reg.risk-low { --rk: var(--water); }
  .reg.risk-very-low { --rk: var(--ink-3); }
  .crumb { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3); margin-bottom: 1.5rem; }
  .crumb a { color: inherit; text-decoration: none; }
  .reg__head { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: start; padding-bottom: 1.5rem; border-bottom: 2px solid var(--ink); }
  .reg__risk { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--rk); font-weight: 500; }
  .reg__head h1 { text-transform: none; font-size: clamp(2.5rem, 6vw, 4.25rem); margin-top: 0.4rem; }
  .reg__lede { font-size: 1.15rem; color: var(--ink-2); margin-top: 1rem; }
  .reg__facts { display: grid; gap: 0; font-size: 0.78rem; border-top: 1px solid var(--line); }
  .reg__facts div { display: grid; grid-template-columns: 8.5rem 1fr; gap: 0.75rem; padding: 0.55rem 0; border-bottom: 1px solid var(--line); }
  .reg__facts dt { color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.06em; }
  .reg__facts dd { margin: 0; color: var(--ink); }
  .reg__facts a { color: var(--ember); }
  .reg__body { display: grid; grid-template-columns: 220px 1fr; gap: 3rem; margin-top: 2rem; align-items: start; }
  .toc { position: sticky; top: 1rem; }
  .toc ol { margin: 0.5rem 0 0; padding-left: 1.2rem; display: grid; gap: 0.4rem; font-size: 0.88rem; }
  .toc a { color: var(--ink-2); text-decoration: none; }
  .toc a:hover { color: var(--rk); }
  .reg__prose section + section { margin-top: 0.5rem; }

  .pcard { padding: 1.1rem 1.25rem; gap: 0.4rem; border-top: 4px solid var(--zone); position: relative; }
  .pcard__n { position: absolute; right: 1rem; top: 0.9rem; font-size: 1.4rem; font-family: var(--display); font-weight: 700; color: var(--zone); opacity: 0.35; }
  .pcard__icon { color: var(--zone); }
  .pcard h3 { text-transform: none; font-size: 1.35rem; }
  .pcard p { font-size: 0.92rem; color: var(--ink-2); }

  .progs { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; border-top: 1px solid var(--line); max-width: 820px; }
  .progs li { padding: 0.9rem 0; border-bottom: 1px solid var(--line); }
  .progs a { font-weight: 600; color: var(--ink); text-decoration: none; }
  .progs a:hover { color: var(--rk); }
  .progs p { font-size: 0.92rem; color: var(--ink-2); margin-top: 0.25rem; }
  .progs__more { margin-top: 1rem; font-size: 0.95rem; color: var(--ink-2); }
  .progs__more a { color: var(--ember); }
  .muted { color: var(--ink-3); }

  .reglist { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.4rem 1.5rem; }
  .reglist a { text-decoration: none; font-size: 0.95rem; display: flex; gap: 0.6rem; }
  .reglist .mono { color: var(--ink-3); font-size: 0.78rem; min-width: 2rem; }
  .reglist a:hover { color: var(--ember); }

  @media (max-width: 900px) { .reg__head { grid-template-columns: 1fr; } .reg__body { grid-template-columns: 1fr; } .toc { position: static; } }
  @media (max-width: 480px) { .reg__facts div { grid-template-columns: 1fr; gap: 0.15rem; } }
</style>
