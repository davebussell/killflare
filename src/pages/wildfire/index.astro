---
import Base from '../../layouts/Base.astro';
import CategoryGrid from '../../components/CategoryGrid.astro';
import ZoneDiagram from '../../components/ZoneDiagram.astro';
import regions from '../../data/regions.json';
import guides from '../../data/guides.json';
const wildfireGuides = ['home-ignition-zone-explained','wildfire-retrofit-priorities-existing-home','how-far-should-trees-be-from-your-house','why-houses-burn-when-the-forest-doesnt','building-a-house-to-survive-wildfire','does-home-insurance-cover-wildfire','sprinklers-vs-gel-vs-retardant'].map((s) => guides.find((g) => g.slug === s)).filter(Boolean);
---
<Base title="Wildfire protection" description="Protecting homes and buildings from wildfire: ember-resistant vents, gutter and roof protection, exterior sprinklers, retardant and gel, pumps and water, defensible space, by zone and by province." pillar="wildfire">
  <section class="section">
    <div class="wrap">
      <span class="eyebrow eyebrow--ember">Wildfire</span>
      <h1>Wildfire protection, by zone</h1>
      <div class="zonewrap">
        <div class="zonewrap__fig"><ZoneDiagram /></div>
        <div>
          <p class="lede">Most homes lost to wildfire are ignited by embers and by burning neighbours, not by the flame front. That puts the decisive work on the building itself and the first few metres around it. FireSmart Canada calls these the Immediate Zone (0–1.5 m), the Intermediate Zone (1.5–10 m) and the Extended Zone (10–30 m); CAL FIRE numbers its zones 0, 1 and 2 in feet. Every category below is filed by the zone it defends.</p>
          <p class="lede lede--sub">Start with the cheap structural fixes (vents, gutters, a clean Immediate Zone) before anything that needs water or a pump. <a href="/guides/wildfire-retrofit-priorities-existing-home/">Our retrofit priority guide</a> ranks them.</p>
        </div>
      </div>
      <h2 class="zh">Harden the structure</h2>
      <CategoryGrid pillar="wildfire" zone="structure" />
      <h2 class="zh">Clear the zones</h2>
      <CategoryGrid pillar="wildfire" zone="yard" />
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="section-head"><h2>Where you live changes the answer</h2><p>Fire season, fuel and provincial programs, province by province.</p></div>
      <ul class="regstrip">
        {regions.map((r) => (
          <li class={`regstrip__i risk-${r.risk.toLowerCase().replace(' ', '-')}`}><a href={`/regions/${r.slug}/`}><span class="mono">{r.code}</span> {r.short}</a></li>
        ))}
      </ul>
      <p class="more"><a href="/live-map/">Live map of wildfire hotspots in Canada and the US →</a> · <a href="/contractors/wildfire/">Wildfire mitigation contractors and free assessment programs →</a></p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="section-head"><h2>Wildfire guides</h2></div>
      <div class="grid grid--2">
        {wildfireGuides.map((g: any) => (
          <a href={`/guides/${g.slug}/`} class="card gcard"><span class="eyebrow">{g.readTime} read</span><h3>{g.title}</h3><p>{g.description}</p></a>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .lede { color: var(--ink-2); font-size: 1.1rem; max-width: var(--measure); }
  .lede--sub { margin-top: 1rem; }
  .zonewrap { display: grid; grid-template-columns: minmax(220px, 300px) 1fr; gap: clamp(1.5rem, 5vw, 3rem); align-items: center; margin: 1.25rem 0 2.5rem; }
  @media (max-width: 820px) { .zonewrap { grid-template-columns: 1fr; } .zonewrap__fig { max-width: 300px; } }
  .zh { font-size: clamp(1.3rem, 2.4vw, 1.6rem); margin: 2rem 0 1rem; }
  .regstrip { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; border: 1px solid var(--line); border-right: 0; border-bottom: 0; background: var(--surface); }
  .regstrip__i { flex: 1 1 168px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); --rk: var(--ink-3); }
  .regstrip__i.risk-extreme { --rk: var(--ember); }
  .regstrip__i.risk-high { --rk: var(--amber); }
  .regstrip__i.risk-moderate { --rk: var(--moss); }
  .regstrip__i.risk-low { --rk: var(--water); }
  .regstrip__i a { display: flex; align-items: center; gap: 0.6rem; padding: 0.7rem 0.9rem; text-decoration: none; font-weight: 500; font-size: 0.95rem; border-left: 3px solid var(--rk); }
  .regstrip__i a:hover { color: var(--rk); background: var(--bg-2); }
  .regstrip__i .mono { font-size: 0.72rem; color: var(--ink-3); min-width: 1.8rem; }
  .more { margin-top: 1.25rem; font-size: 0.95rem; }
  .gcard { padding: 1.5rem; gap: 0.6rem; }
  .gcard h3 { text-transform: none; }
  .gcard p { color: var(--ink-2); font-size: 0.95rem; }
</style>
