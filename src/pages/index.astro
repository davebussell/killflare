---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import CatIcon from '../components/CatIcon.astro';
import ZoneDiagram from '../components/ZoneDiagram.astro';
import Photo from '../components/Photo.astro';
import categories from '../data/categories.json';
import products from '../data/products.json';
import guides from '../data/guides.json';
import regions from '../data/regions.json';
const homeCats = categories.filter((c) => c.pillar === 'home');

const featuredSlugs = ['wasp-wildfire-protection-full-kit', 'phos-chek-home-defense', 'vulcan-vents', 'portable-gas-fire-pump', 'n95-p100-respirators', 'barricade-fire-gel'];
const featured = featuredSlugs.map((s) => products.find((p) => p.slug === s)).filter(Boolean);
const zones = [
  { key: 'structure', label: 'Harden the structure', blurb: 'Vents, gutters, sprinklers, gel — what stops embers from getting in or igniting the walls.' },
  { key: 'yard', label: 'Clear the zones', blurb: 'The tools for Zone 0 and Zone 1: the 10 metres that decide whether the house survives.' },
  { key: 'people', label: 'Protect the people', blurb: 'Alerts, go-bags, respirators and clean indoor air for the weeks of smoke either side of a fire.' },
];
---
<Base title="Killflare" description="Independent, plain-language guides to wildfire home defense supplies — exterior sprinklers, fire gel, ember-resistant vents, pumps, go-bags and smoke protection — for homeowners in Canada and the US.">
  <section class="hero">
    <div class="hero__bg"><Photo name="hero" eager={true} ratio="22 / 10" sizes="100vw" credit={false} /></div>
    <div class="wrap hero__in">
      <div class="hero__copy">
        <span class="eyebrow eyebrow--ember">Wildfire home defense · Canada &amp; US</span>
        <h1>Most homes are lost to embers.<br /><span class="hero__accent">Protect your Legacy</span></h1>
        <p class="hero__lede">Killflare is a field guide to the equipment that keeps a house standing when the forest burns: what works, what's marketing, and what order to buy it in. Written for homeowners, organised around the Home Ignition Zone that FireSmart Canada and NFPA Firewise both use.</p>
        <div class="hero__cta">
          <a href="/start-here/" class="btn btn--ember">Start with the priority list</a>
          <a href="/categories/" class="btn">Browse all gear</a>
        </div>
      </div>
    </div>
    <p class="hero__credit mono wrap">Hero photo <a href="https://unsplash.com/photos/kbTp7dBzHyY?utm_source=killflare&amp;utm_medium=referral" rel="noopener nofollow" target="_blank">Matt Palmer</a> / Unsplash
    </p>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="zonewrap">
        <div class="zonewrap__fig">
          <ZoneDiagram />
        </div>
        <div class="zonewrap__copy">
          <h2>Everything here maps to a zone</h2>
          <p>FireSmart Canada and NFPA Firewise both work outward from the house: the closer to the walls, the stricter the rule. FireSmart calls them the Immediate Zone (the 1.5 m that must not burn), the Intermediate Zone (out to 10 m, which decides the outcome) and the Extended Zone (the thinning beyond). CAL FIRE numbers its own zones 0, 1 and 2 in feet. Every product on this site is filed by the zone it defends.</p>
          <a href="/guides/home-ignition-zone-explained/" class="btn btn--ghost">Read the zone guide</a>
        </div>
      </div>
      <div class="zones">
        {zones.map((z) => (
          <div class={`zone zone-${z.key}`}>
            <h2 class="zone__h">{z.label}</h2>
            <p>{z.blurb}</p>
            <ul class="zone__cats">
              {categories.filter((c) => c.pillar === 'wildfire' && c.zone === z.key).map((c) => (
                <li><a href={`/categories/${c.slug}/`}><CatIcon name={c.icon} size={20} /> {c.name}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Our top picks</h2>
        <p>The six products we'd buy first, in roughly this order.</p>
      </div>
      <div class="grid grid--3 picks">
        {featured.map((p) => <ProductCard product={p} showCategory />)}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="notice">
        <p><strong>A note on water.</strong> Almost every product in the "structure" zone depends on water pressure that municipal systems lose during a major fire. If you buy one expensive thing, make it a <a href="/categories/pumps-and-water/">pump and a tank</a>, not a fancier sprinkler head.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Where you live changes the answer</h2>
        <p>Fire season, fuel and provincial programs, province by province.</p>
      </div>
      <ul class="regstrip">
        {regions.map((r) => (
          <li class={`regstrip__i risk-${r.risk.toLowerCase().replace(' ', '-')}`}>
            <a href={`/regions/${r.slug}/`}><span class="mono">{r.code}</span> {r.short}</a>
          </li>
        ))}
      </ul>
      <div class="regstrip__foot">
        <a href="/regions/" class="btn btn--ghost">All regional guides</a>
        <p class="regstrip__offer">Or get a nudge when risk rises near you — <a href="/alerts/">Priority Alerts, $1/month</a>. A supplement to your provincial alerts, never a replacement.</p>
      </div>
    </div>
  </section>


  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow eyebrow--ember">The rest of the house</span>
          <h2>Fire doesn't only come from outside</h2>
        </div>
        <p>Most house fires have nothing to do with a wildfire. Cooking, heating and electrical faults start far more of them, and a working smoke alarm still does more for survival than anything else you can buy.</p>
      </div>
      <ul class="homecats">
        {homeCats.map((c) => (
          <li class={`homecat zone-${c.zone}`}>
            <a href={`/categories/${c.slug}/`}>
              <span class="homecat__ico"><CatIcon name={c.icon} size={22} /></span>
              <span class="homecat__t">{c.name}</span>
              <span class="homecat__d">{c.tagline}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="regstrip__foot">
        <a href="/home-safety/" class="btn btn--ghost">All home fire safety</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Guides</h2>
        <p>Longer reads on the decisions behind the shopping list.</p>
      </div>
      <div class="grid grid--2">
        {guides.map((g) => (
          <a href={`/guides/${g.slug}/`} class="card gcard">
            <span class="eyebrow">{g.readTime} read</span>
            <h3>{g.title}</h3>
            <p>{g.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; background: var(--bg-2); border-bottom: 1px solid var(--line); overflow: hidden; isolation: isolate; }
  .hero__bg { position: absolute; inset: 0; z-index: -2; }
  .hero__bg, .hero__bg :global(.photo) { height: 100%; }
  .hero__bg :global(.photo img) { width: 100%; height: 100%; aspect-ratio: auto; object-fit: cover; }
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(100deg,
      var(--bg) 0%,
      color-mix(in srgb, var(--bg) 97%, transparent) 30%,
      color-mix(in srgb, var(--bg) 72%, transparent) 50%,
      color-mix(in srgb, var(--bg) 22%, transparent) 72%,
      transparent 100%);
  }
  .hero__credit { font-size: 0.62rem; color: var(--ink-3); padding-bottom: 0.75rem; max-width: none; }
  .hero__credit a { color: inherit; }
  @media (max-width: 820px) { .hero::before { background: linear-gradient(180deg, color-mix(in srgb, var(--bg) 55%, transparent) 0%, color-mix(in srgb, var(--bg) 92%, transparent) 38%, var(--bg) 68%); } }
  .hero__in { display: grid; grid-template-columns: minmax(0, 62%); gap: clamp(2rem, 5vw, 4rem); align-items: center; padding-block: clamp(3.5rem, 9vw, 7rem); }
  .hero__copy { display: grid; gap: 1.25rem; }
  .hero__accent { color: var(--hunter); }
  .hero__lede { font-size: 1.15rem; color: var(--ink-2); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .hero__fig { max-width: 420px; justify-self: end; width: 100%; }
  @media (max-width: 820px) { .hero__in { grid-template-columns: 1fr; } }

  .zonewrap { display: grid; grid-template-columns: minmax(240px, 320px) 1fr; gap: clamp(1.5rem, 5vw, 3.5rem); align-items: center; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .zonewrap__fig { width: 100%; }
  .zonewrap__copy { display: grid; gap: 0.9rem; justify-items: start; }
  .zonewrap__copy h2 { font-size: clamp(1.4rem, 2.6vw, 1.85rem); }
  .zonewrap__copy p { color: var(--ink-2); }
  @media (max-width: 820px) { .zonewrap { grid-template-columns: 1fr; } .zonewrap__fig { max-width: 320px; } }
  .zones { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 0; border: 1px solid var(--line); background: var(--surface); }
  .zone { padding: 1.5rem; border-top: 6px solid var(--zone); }
  .zone + .zone { border-left: 1px solid var(--line); }
  .zone__h { font-size: 1.35rem; color: var(--zone); margin-bottom: 0.5rem; }
  .zone p { font-size: 0.95rem; color: var(--ink-2); }
  .zone__cats { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.4rem; }
  .zone__cats a { display: flex; align-items: center; gap: 0.5rem; text-decoration: none; font-weight: 500; font-size: 0.97rem; color: var(--ink); }
  .zone__cats a:hover { color: var(--zone); }
  @media (max-width: 900px) { .zone + .zone { border-left: 0; border-top: 6px solid var(--zone); } }

  .picks { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 900px) { .picks { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); } }
  .regstrip { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0; border: 1px solid var(--line); border-right: 0; border-bottom: 0; background: var(--surface); }
  .regstrip__i { flex: 1 1 168px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); --rk: var(--ink-3); }
  .regstrip__i.risk-extreme { --rk: var(--ember); }
  .regstrip__i.risk-high { --rk: var(--amber); }
  .regstrip__i.risk-moderate { --rk: var(--moss); }
  .regstrip__i.risk-low { --rk: var(--water); }
  .regstrip__i a { display: flex; align-items: center; gap: 0.6rem; padding: 0.7rem 0.9rem; text-decoration: none; font-weight: 500; font-size: 0.95rem; border-left: 3px solid var(--rk); }
  .regstrip__i a:hover { color: var(--rk); background: var(--bg-2); }
  .regstrip__i .mono { font-size: 0.72rem; color: var(--ink-3); min-width: 1.8rem; }
  .regstrip__foot { margin-top: 1.25rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; }
  .regstrip__offer { font-size: 0.9rem; color: var(--ink-3); max-width: 46ch; }
  .regstrip__offer a { color: var(--hunter); font-weight: 500; }

  .homecats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 0; border: 1px solid var(--line); border-right: 0; border-bottom: 0; background: var(--surface); }
  .homecat { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .homecat a { display: grid; grid-template-columns: auto 1fr; gap: 0.15rem 0.75rem; padding: 1.1rem 1.25rem; text-decoration: none; height: 100%; align-content: start; border-left: 3px solid var(--zone); }
  .homecat a:hover { background: var(--bg-2); }
  .homecat__ico { color: var(--zone); grid-row: span 2; padding-top: 0.15rem; }
  .homecat__t { font-family: var(--display); font-weight: 600; font-size: 1rem; color: var(--ink); }
  .homecat__d { font-size: 0.88rem; color: var(--ink-2); }
  .gcard { padding: 1.5rem; gap: 0.6rem; }
  .gcard h3 { text-transform: none; }
  .gcard p { color: var(--ink-2); font-size: 0.95rem; }
</style>
