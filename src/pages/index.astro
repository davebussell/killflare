---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import CatIcon from '../components/CatIcon.astro';
import Photo from '../components/Photo.astro';
import categories from '../data/categories.json';
import products from '../data/products.json';
import guides from '../data/guides.json';
import { services, companies, regions as cRegions } from '../lib/contractors';

const featuredSlugs = ['sealed-10-year-smoke-alarm', '10lb-abc-extinguisher', 'commercial-hood-wet-chemical', 'central-station-communicators', 'stainless-ember-mesh', 'wasp-wildfire-protection-full-kit'];
const featured = featuredSlugs.map((s) => products.find((p) => p.slug === s)).filter(Boolean);
const pillars = [
  { key: 'home', label: 'Home', href: '/home-safety/', icon: 'home', blurb: 'Alarms, extinguishers, sprinklers, and the everyday causes: cooking, heating, wiring and batteries.' },
  { key: 'business', label: 'Business', href: '/business/', icon: 'building', blurb: 'Sprinkler, kitchen, clean agent and alarm systems, extinguishers, emergency lighting: what the code requires and how it is bought.' },
  { key: 'wildfire', label: 'Wildfire', href: '/wildfire/', icon: 'tree', blurb: 'Ember-resistant vents, gutters, exterior sprinklers, retardant, water and defensible space, by zone and by province.' },
];
const count = (k: string) => products.filter((p) => categories.find((c) => c.slug === p.category)?.pillar === k).length;
const regionCount = cRegions.filter((r) => r.count > 0).length;
const recentGuides = guides.slice(-6).reverse();
---
<Base title="Killflare" description="Independent guides to fire protection for homes and businesses in Canada and the US: what to buy, what to have installed, what the code requires, what it costs, and verified contractors by city.">
  <section class="hero">
    <div class="hero__bg"><Photo name="hero" eager={true} ratio="22 / 10" sizes="100vw" credit={false} /></div>
    <div class="wrap hero__in">
      <div class="hero__copy">
        <span class="eyebrow eyebrow--ember">Fire protection · Homes &amp; businesses · Canada &amp; US</span>
        <h1>Most fire losses are decided before the fire starts.<br /><span class="hero__accent">Protect your Legacy</span></h1>
        <p class="hero__lede">Killflare explains fire protection in plain language: which products and systems work, what your building code requires, what they cost to buy and to keep compliant, where they are actually sold, and which contractors install and service them.</p>
        <div class="hero__cta">
          <a href="/start-here/" class="btn btn--ember">Where to start</a>
          <a href="/contractors/" class="btn">Find a contractor</a>
        </div>
      </div>
    </div>
    <p class="hero__credit mono wrap">Hero photo <a href="https://unsplash.com/photos/kbTp7dBzHyY?utm_source=killflare&amp;utm_medium=referral" rel="noopener nofollow" target="_blank">Matt Palmer</a> / Unsplash</p>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <ul class="pillars">
        {pillars.map((pl) => (
          <li class={`pillar pillar--${pl.key}`}>
            <a href={pl.href} class="pillar__head">
              <span class="pillar__ico"><CatIcon name={pl.icon} size={30} /></span>
              <span><span class="pillar__t">{pl.label}</span><span class="pillar__n mono">{count(pl.key)} guides</span></span>
            </a>
            <p>{pl.blurb}</p>
            <ul class="pillar__cats">
              {categories.filter((c) => c.pillar === pl.key).map((c) => <li><a href={`/categories/${c.slug}/`}>{c.short}</a></li>)}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>Three things most people get wrong</h2></div>
      <div class="truths">
        <article>
          <span class="mono">Alarms</span>
          <h3>The alarm is fine. The battery isn't.</h3>
          <p>Most smoke alarm failures are missing or dead batteries. A sealed ten-year unit or a hardwired, interconnected system takes the human step out.</p>
          <a href="/guides/smoke-and-co-alarms-what-the-law-says/">What to buy and what the law says →</a>
        </article>
        <article>
          <span class="mono">Sprinklers</span>
          <h3>Sprinklers rarely fail. Closed valves do.</h3>
          <p>In NFPA's data, most sprinkler failures were systems that had been shut off before the fire. Inspection to NFPA 25 matters as much as the install.</p>
          <a href="/contractors/sprinklers/">Sprinkler contractors and inspection schedules →</a>
        </article>
        <article>
          <span class="mono">Wildfire</span>
          <h3>Houses are lost to embers, not walls of flame.</h3>
          <p>Vents, gutters and the first 1.5 metres around the house decide most outcomes. They are also the cheapest things to fix.</p>
          <a href="/guides/why-houses-burn-when-the-forest-doesnt/">Why houses burn when the forest doesn't →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="cband">
        <div>
          <span class="eyebrow eyebrow--ember">Contractors</span>
          <h2>The right trade for the job</h2>
          <p>{services.length} types of fire protection contractor, what each one does, the licences to check and the inspections the code sets, with {companies.length} companies verified across {regionCount} provinces and states.</p>
          <a href="/contractors/" class="btn btn--ember">Find a contractor</a>
        </div>
        <ul class="cband__svc">
          {services.map((s) => <li><a href={`/contractors/${s.key}/`}>{s.name}</a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>Where we'd start</h2><p>Six picks across home, business and wildfire. <a href="/categories/">All products and systems →</a></p></div>
      <div class="grid grid--3 picks">{featured.map((p) => <ProductCard product={p} showCategory />)}</div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="notice">
        <p><strong>Wildfire season?</strong> Our <a href="/live-map/">live map</a> shows satellite hotspots across Canada and the US from the last 24 hours, and our <a href="/regions/">regional guides</a> cover fire season, fuel and provincial programs province by province.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>Guides</h2><p><a href="/guides/">All guides →</a></p></div>
      <div class="grid grid--2">
        {recentGuides.map((g) => (
          <a href={`/guides/${g.slug}/`} class="card gcard"><span class="eyebrow">{g.readTime} read</span><h3>{g.title}</h3><p>{g.description}</p></a>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .pillars { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 0; border: 1px solid var(--line); background: var(--surface); }
  .pillar { padding: 1.5rem; border-top: 5px solid var(--ember); display: grid; gap: 0.75rem; align-content: start; }
  .pillar--home { border-top-color: var(--water); }
  .pillar--wildfire { border-top-color: var(--hunter); }
  .pillar + .pillar { border-left: 1px solid var(--line); }
  @media (max-width: 900px) { .pillar + .pillar { border-left: 0; } }
  .pillar__head { display: flex; gap: 0.8rem; align-items: center; text-decoration: none; }
  .pillar__ico { color: var(--ink); }
  .pillar__t { display: block; font-family: var(--display); font-weight: 700; font-size: 1.5rem; color: var(--ink); line-height: 1.1; }
  .pillar__n { display: block; font-size: 0.7rem; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.08em; }
  .pillar p { font-size: 0.93rem; color: var(--ink-2); }
  .pillar__cats { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .pillar__cats a { display: inline-block; font-size: 0.82rem; padding: 0.18rem 0.5rem; border: 1px solid var(--line); text-decoration: none; color: var(--ink-2); background: var(--bg); }
  .pillar__cats a:hover { border-color: var(--ink); color: var(--ink); }
  .truths { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; }
  .truths article { display: grid; gap: 0.5rem; align-content: start; }
  .truths .mono { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ember); }
  .truths h3 { font-size: 1.2rem; text-transform: none; }
  .truths p { color: var(--ink-2); font-size: 0.95rem; }
  .truths a { font-weight: 500; font-size: 0.92rem; }
  .cband { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; background: var(--char); color: var(--char-ink); padding: clamp(1.5rem, 4vw, 2.5rem); }
  .cband p { color: var(--char-ink-2); margin: 0.75rem 0 1.25rem; }
  .cband h2 { color: var(--char-ink); }
  .cband__svc { list-style: none; margin: 0; padding: 0; columns: 2 180px; column-gap: 1.5rem; }
  .cband__svc li { padding: 0.35rem 0; break-inside: avoid; border-bottom: 1px solid #333936; }
  .cband__svc a { color: var(--char-ink); text-decoration: none; font-size: 0.92rem; }
  .cband__svc a:hover { color: var(--ember); }
  @media (max-width: 760px) { .cband { grid-template-columns: 1fr; } }

  .hero { position: relative; background: var(--bg-2); border-bottom: 1px solid var(--line); overflow: hidden; isolation: isolate; }
  .hero__bg { position: absolute; inset: 0; z-index: -2; }
  .hero__bg, .hero__bg :global(.photo) { height: 100%; }
  .hero__bg :global(.photo img) { width: 100%; height: 100%; aspect-ratio: auto; object-fit: cover; }
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(100deg,
      var(--bg) 0%,
      color-mix(in srgb, var(--bg) 97%, transparent) 30%,
      color-mix(in srgb, var(--bg) 72%, transparent) 50%,
      color-mix(in srgb, var(--bg) 22%, transparent) 72%,
      transparent 100%);
  }
  .hero__credit { font-size: 0.62rem; color: var(--ink-3); padding-bottom: 0.75rem; max-width: none; }
  .hero__credit a { color: inherit; }
  @media (max-width: 820px) { .hero::before { background: linear-gradient(180deg, color-mix(in srgb, var(--bg) 55%, transparent) 0%, color-mix(in srgb, var(--bg) 92%, transparent) 38%, var(--bg) 68%); } }
  .hero__in { display: grid; grid-template-columns: minmax(0, 62%); gap: clamp(2rem, 5vw, 4rem); align-items: center; padding-block: clamp(3.5rem, 9vw, 7rem); }
  .hero__copy { display: grid; gap: 1.25rem; }
  .hero__accent { color: var(--hunter); }
  .hero__lede { font-size: 1.15rem; color: var(--ink-2); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .hero__fig { max-width: 420px; justify-self: end; width: 100%; }
  @media (max-width: 820px) { .hero__in { grid-template-columns: 1fr; } }

  .zonewrap { display: grid; grid-template-columns: minmax(240px, 320px) 1fr; gap: clamp(1.5rem, 5vw, 3.5rem); align-items: center; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .zonewrap__fig { width: 100%; }
  .zonewrap__copy { display: grid; gap: 0.9rem; justify-items: start; }
  .zonewrap__copy h2 { font-size: clamp(1.4rem, 2.6vw, 1.85rem); }
  .zonewrap__copy p { color: var(--ink-2); }
  @media (max-width: 820px) { .zonewrap { grid-template-columns: 1fr; } .zonewrap__fig { max-width: 320px; } }
  .zones { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 0; border: 1px solid var(--line); background: var(--surface); }
  .zone { padding: 1.5rem; border-top: 6px solid var(--zone); }
  .zone + .zone { border-left: 1px solid var(--line); }
  .zone__h { font-size: 1.35rem; color: var(--zone); margin-bottom: 0.5rem; }
  .zone p { font-size: 0.95rem; color: var(--ink-2); }
  .zone__cats { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.4rem; }
  .zone__cats a { display: flex; align-items: center; gap: 0.5rem; text-decoration: none; font-weight: 500; font-size: 0.97rem; color: var(--ink); }
  .zone__cats a:hover { color: var(--zone); }
  @media (max-width: 900px) { .zone + .zone { border-left: 0; border-top: 6px solid var(--zone); } }

  .picks { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 900px) { .picks { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); } }
  .regstrip { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0; border: 1px solid var(--line); border-right: 0; border-bottom: 0; background: var(--surface); }
  .regstrip__i { flex: 1 1 168px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); --rk: var(--ink-3); }
  .regstrip__i.risk-extreme { --rk: var(--ember); }
  .regstrip__i.risk-high { --rk: var(--amber); }
  .regstrip__i.risk-moderate { --rk: var(--moss); }
  .regstrip__i.risk-low { --rk: var(--water); }
  .regstrip__i a { display: flex; align-items: center; gap: 0.6rem; padding: 0.7rem 0.9rem; text-decoration: none; font-weight: 500; font-size: 0.95rem; border-left: 3px solid var(--rk); }
  .regstrip__i a:hover { color: var(--rk); background: var(--bg-2); }
  .regstrip__i .mono { font-size: 0.72rem; color: var(--ink-3); min-width: 1.8rem; }
  .regstrip__foot { margin-top: 1.25rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; }
  .regstrip__offer { font-size: 0.9rem; color: var(--ink-3); max-width: 46ch; }
  .regstrip__offer a { color: var(--hunter); font-weight: 500; }

  .homecats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 0; border: 1px solid var(--line); border-right: 0; border-bottom: 0; background: var(--surface); }
  .homecat { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .homecat a { display: grid; grid-template-columns: auto 1fr; gap: 0.15rem 0.75rem; padding: 1.1rem 1.25rem; text-decoration: none; height: 100%; align-content: start; border-left: 3px solid var(--zone); }
  .homecat a:hover { background: var(--bg-2); }
  .homecat__ico { color: var(--zone); grid-row: span 2; padding-top: 0.15rem; }
  .homecat__t { font-family: var(--display); font-weight: 600; font-size: 1rem; color: var(--ink); }
  .homecat__d { font-size: 0.88rem; color: var(--ink-2); }
  .gcard { padding: 1.5rem; gap: 0.6rem; }
  .gcard h3 { text-transform: none; }
  .gcard p { color: var(--ink-2); font-size: 0.95rem; }
</style>
