---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import Photo from '../../components/Photo.astro';
import guides from '../../data/guides.json';
import products from '../../data/products.json';

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props;
const byId = (s: string) => products.find((p) => p.slug === s);
const others = guides.filter((x) => x.slug !== g.slug);
const jsonLd = { '@context': 'https://schema.org', '@type': 'Article', headline: g.title, description: g.description, publisher: { '@type': 'Organization', name: 'Killflare' } };
---
<Base title={g.title} description={g.description} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="gbanner">
    <Photo name={g.photo} eager={true} ratio="21 / 6" sizes="100vw" />
  </div>
  <article class="guide">
    <div class="wrap">
      <header class="guide__head">
        <span class="eyebrow eyebrow--ember">Guide · {g.readTime} read</span>
        <h1>{g.title}</h1>
        <p class="guide__lede">{g.description}</p>
      </header>
      <div class="guide__body">
        <nav class="toc" aria-label="Sections">
          <span class="eyebrow">In this guide</span>
          <ol>{g.sections.map((s, i) => <li><a href={`#s${i}`}>{s.heading}</a></li>)}</ol>
        </nav>
        <div class="prose">
          {g.sections.map((s, i) => (
            <section id={`s${i}`} class="gsec">
              <h2>{s.heading}</h2>
              <p>{s.body}</p>
              {s.products && s.products.length > 0 && (
                <div class="gsec__products">
                  <span class="eyebrow">Gear for this step</span>
                  <div class="grid grid--3 gsec__grid">{s.products.map((slug) => { const p = byId(slug); return p ? <ProductCard product={p} /> : null; })}</div>
                </div>
              )}
            </section>
          ))}
        </div>
      </div>
    </div>
  </article>
  <section class="section section--tight">
    <div class="wrap">
      <div class="section-head"><h2>More guides</h2></div>
      <div class="grid grid--2">
        {others.map((o) => (
          <a href={`/guides/${o.slug}/`} class="card gcard"><span class="eyebrow">{o.readTime} read</span><h3>{o.title}</h3><p>{o.description}</p></a>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .gbanner { position: relative; border-bottom: 4px solid var(--ember); }
  .gbanner::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 40%, color-mix(in srgb, var(--bg) 72%, transparent)); pointer-events: none; }
  .guide { padding-block: clamp(1.5rem, 3vw, 2.5rem) 1rem; }
  .guide__head { display: grid; gap: 0.75rem; max-width: 820px; padding-bottom: 1.5rem; border-bottom: 2px solid var(--ink); }
  .guide__head h1 { font-size: clamp(1.9rem, 3.8vw, 2.9rem); }
  .guide__lede { font-size: 1.15rem; color: var(--ink-2); }
  .guide__body { display: grid; grid-template-columns: 220px 1fr; gap: 3rem; margin-top: 2rem; align-items: start; }
  .toc { position: sticky; top: 1rem; }
  .toc ol { margin: 0.5rem 0 0; padding-left: 1.2rem; display: grid; gap: 0.4rem; font-size: 0.9rem; }
  .toc a { color: var(--ink-2); text-decoration: none; }
  .toc a:hover { color: var(--ember); }
  .prose { max-width: none; }
  .prose > .gsec > p { max-width: var(--measure); }
  .gsec:first-child h2 { margin-top: 0; }
  .gsec__products { margin-top: 1.25rem; display: grid; gap: 0.5rem; }
  .gsec__grid { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .gcard { padding: 1.5rem; gap: 0.6rem; }
  .gcard h3 { text-transform: none; }
  .gcard p { color: var(--ink-2); font-size: 0.95rem; }
  @media (max-width: 820px) { .guide__body { grid-template-columns: 1fr; } .toc { position: static; } }
</style>
