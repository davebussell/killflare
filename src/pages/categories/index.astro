---
import Base from '../../layouts/Base.astro';
import CatIcon from '../../components/CatIcon.astro';
import categories from '../../data/categories.json';
import products from '../../data/products.json';
---
<Base title="All gear" description="Every category of wildfire home defense equipment we cover — from exterior sprinklers and fire gel to respirators and weather radios.">
  <section class="section">
    <div class="wrap">
      <span class="eyebrow eyebrow--ember">Gear</span>
      <h1>All categories</h1>
      <p class="lede">Grouped by what they protect: the structure, the yard around it, or the people inside.</p>
      <div class="grid grid--3 cats">
        {categories.map((c) => {
          const n = products.filter((p) => p.category === c.slug).length;
          return (
            <a href={`/categories/${c.slug}/`} class={`card cat zone-${c.zone}`}>
              <div class="cat__icon"><CatIcon name={c.icon} size={28} /></div>
              <h3>{c.name}</h3>
              <p>{c.tagline}</p>
              <span class="cat__n mono">{n} {n === 1 ? 'pick' : 'picks'}</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Base>
<style>
  .lede { color: var(--ink-2); margin: 0.75rem 0 2rem; font-size: 1.1rem; }
  .cat { padding: 1.25rem; gap: 0.6rem; border-top: 4px solid var(--zone); }
  .cat__icon { color: var(--zone); }
  .cat h3 { text-transform: none; }
  .cat p { font-size: 0.93rem; color: var(--ink-2); }
  .cat__n { margin-top: auto; padding-top: 0.5rem; font-size: 0.72rem; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.1em; }
</style>
