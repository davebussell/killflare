---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import CatIcon from '../../components/CatIcon.astro';
import categories from '../../data/categories.json';
import products from '../../data/products.json';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug }, props: { cat: c } }));
}
const { cat } = Astro.props;
const picks = products.filter((p) => p.category === cat.slug);
const zoneLabel = { structure: 'Structure', yard: 'Yard & zones', people: 'People & air' }[cat.zone];
---
<Base title={cat.name} description={`${cat.tagline} Our picks and buying notes for ${cat.name.toLowerCase()}.`}>
  <section class={`section catpage zone-${cat.zone}`}>
    <div class="wrap">
      <nav class="crumb mono" aria-label="Breadcrumb"><a href="/categories/">Gear</a> / {zoneLabel}</nav>
      <div class="cathead">
        <div class="cathead__icon"><CatIcon name={cat.icon} size={44} /></div>
        <div>
          <h1>{cat.name}</h1>
          <p class="cathead__tag">{cat.tagline}</p>
        </div>
      </div>
      <p class="intro">{cat.intro}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="section-head"><h2>Our picks</h2><p>{picks.length} {picks.length === 1 ? 'product' : 'products'} · price bands $ to $$$$</p></div>
      <div class="grid grid--3">
        {picks.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="section-head"><h2>Before you buy</h2></div>
      <ol class={`notes zone-${cat.zone}`}>
        {cat.buyingNotes.map((n) => <li>{n}</li>)}
      </ol>
    </div>
  </section>
</Base>
<style>
  .crumb { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3); margin-bottom: 1.5rem; }
  .crumb a { color: inherit; text-decoration: none; }
  .cathead { display: flex; gap: 1.25rem; align-items: flex-start; }
  .cathead__icon { color: var(--zone); flex: none; padding-top: 0.4rem; }
  .cathead__tag { font-size: 1.2rem; color: var(--zone); font-weight: 500; margin-top: 0.75rem; }
  .intro { margin-top: 1.5rem; font-size: 1.1rem; color: var(--ink-2); }
  .notes { margin: 0; padding: 0; list-style: none; counter-reset: n; display: grid; gap: 0; border-top: 1px solid var(--line); max-width: 820px; }
  .notes li { counter-increment: n; display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .notes li::before { content: counter(n, decimal-leading-zero); font-family: var(--display); font-weight: 700; font-size: 1.6rem; line-height: 1.2; color: var(--zone); }
  @media (max-width: 560px) { .cathead { flex-direction: column; gap: 0.5rem; } }
</style>
