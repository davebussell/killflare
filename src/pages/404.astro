---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page doesn't exist.">
  <section class="section">
    <div class="wrap">
      <span class="eyebrow eyebrow--ember">404</span>
      <h1>Nothing here</h1>
      <p style="margin-top:1rem;color:var(--ink-2)">That page has moved or never existed. Try the <a href="/start-here/">priority list</a> or <a href="/categories/">all gear</a>.</p>
    </div>
  </section>
</Base>
