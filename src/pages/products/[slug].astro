---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductImage from '../../components/ProductImage.astro';
import Effort from '../../components/Effort.astro';
import categories from '../../data/categories.json';
import products from '../../data/products.json';
import { resolveLink, HAS_AFFILIATE_TAGS } from '../../config';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const cat = categories.find((c) => c.slug === p.category)!;
const hub = cat.pillar === 'home' ? { href: '/home-safety/', label: 'Home safety' } : { href: '/categories/', label: 'Wildfire gear' };
const related = products.filter((x) => x.category === p.category && x.slug !== p.slug).slice(0, 3);
const regionNames = p.region.map((r: string) => (r === 'CA' ? 'Canada' : 'United States')).join(' & ');
const g: any = (p as any).guide;
const affiliate = p.links.filter((l: any) => l.kind === 'affiliate');
const direct = p.links.filter((l: any) => l.kind === 'direct');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  brand: { '@type': 'Brand', name: p.brand },
  description: p.summary,
  category: cat.name,
};
---
<Base title={p.name} description={`${p.pick}: ${p.summary}`} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class={`prod zone-${cat.zone}`}>
    <div class="wrap">
      <nav class="crumb mono" aria-label="Breadcrumb"><a href={hub.href}>{hub.label}</a> / <a href={`/categories/${cat.slug}/`}>{cat.short}</a></nav>
      <div class="prod__grid">
        <div class="prod__main">
          <span class="prod__pick">{p.pick}</span>
          <h1 class="prod__name">{p.name}</h1>
          <div class="prod__meta mono">
            <span>{p.brand}</span>
            <span>{regionNames}</span>
            <span title={p.priceNote}>{p.priceBand} <em>· {p.priceNote}</em></span>
          </div>
          <p class="prod__sum">{p.summary}</p>

          <div class="prod__pc">
            <div>
              <h2 class="prod__h">Why we like it</h2>
              <ul>{p.pros.map((x: string) => <li>{x}</li>)}</ul>
            </div>
            <div>
              <h2 class="prod__h prod__h--con">Watch out for</h2>
              <ul>{p.cons.map((x: string) => <li>{x}</li>)}</ul>
            </div>
          </div>

          <div class="prod__best">
            <span class="eyebrow">Best for</span>
            <p>{p.bestFor}</p>
          </div>

          {g && (
            <a href="#market-guide" class="prod__jump">Read the full market guide — costs, install effort and alternatives ↓</a>
          )}
        </div>

        <aside class="prod__buy">
          <ProductImage product={p} ratio="4 / 3" size={72} eager={true} />
          <span class="eyebrow">Where to buy</span>
          <div class="buy__links">
            {affiliate.map((l: any) => <a href={resolveLink(l.url)} class="btn btn--ember" rel="sponsored noopener" target="_blank">{l.label}</a>)}
            {direct.map((l: any) => <a href={resolveLink(l.url)} class="btn btn--ghost" rel="noopener" target="_blank">{l.label}</a>)}
          </div>
          <p class="buy__fine">Prices change daily and vary by region, so we show a price band rather than a number. {HAS_AFFILIATE_TAGS ? 'Affiliate links earn us a small commission at no cost to you.' : 'We are not yet in any affiliate program, so these links earn us nothing today.'} <a href="/about/#disclosure">How we make money.</a></p>
          <div class="buy__cat">
            <span class="eyebrow">Category</span>
            <a href={`/categories/${cat.slug}/`}>{cat.name} →</a>
            <p>{cat.tagline}</p>
          </div>
        </aside>
      </div>
    </div>
  </article>


  {g && (
    <section class={`guide zone-${cat.zone}`} id="market-guide">
      <div class="wrap">
        <div class="section-head">
          <div>
            <span class="eyebrow eyebrow--ember">Market guide</span>
            <h2>The whole commitment, end to end</h2>
          </div>
          <p>What this actually is, what the market looks like, what it really costs, and how much of your time it wants — before you spend anything.</p>
        </div>

        <div class="atglance">
          <div class="atglance__efforts">
            <Effort level={g.buying.effort} label="Buying it" />
            <Effort level={g.install.effort} label="Installing it" />
            <Effort level={g.ongoing.effort} label="Living with it" />
          </div>
          <div class="atglance__cost">
            <span class="eff__lab mono">Up front</span>
            <p>{g.costs.upfront}</p>
            <span class="eff__lab mono">Lead time</span>
            <p>{g.buying.lead}</p>
            <span class="eff__lab mono">Time to install</span>
            <p>{g.install.time}</p>
          </div>
        </div>

        <div class="gsec">
          <h3>How it works</h3>
          <p>{g.howItWorks}</p>
        </div>

        <div class="gsec">
          <h3>What the market looks like</h3>
          <p>{g.market}</p>
        </div>

        <div class="gsec">
          <h3>Features that actually matter</h3>
          <dl class="gspec">
            {g.features.map((f: any) => (<><dt>{f.label}</dt><dd>{f.detail}</dd></>))}
          </dl>
        </div>

        <div class="gsec">
          <h3>What it really costs</h3>
          <dl class="gspec gspec--cost">
            <dt>Up front</dt><dd>{g.costs.upfront}</dd>
            <dt>Consumables</dt><dd>{g.costs.consumables}</dd>
            <dt>What else you'll need</dt><dd>{g.costs.ancillary}</dd>
            <dt>Over five years</dt><dd>{g.costs.fiveYear}</dd>
          </dl>
          <p class="gfine">Figures are typical street prices in Canadian and US dollars as of September 2026, gathered from public retail listings. They move with the season and with the exchange rate — treat them as a planning band, not a quote.</p>
        </div>

        <div class="gsec">
          <h3>How it differs from the alternatives</h3>
          <dl class="gspec">
            {g.differentiators.map((f: any) => (<><dt>{f.label}</dt><dd>{f.detail}</dd></>))}
          </dl>
        </div>

        <div class="gsteps">
          <div class="gstep">
            <div class="gstep__head"><span class="mono">01</span><h3>Buying it</h3></div>
            <Effort level={g.buying.effort} label="Effort" />
            <p><strong>Where:</strong> {g.buying.where}</p>
            <p><strong>Lead time:</strong> {g.buying.lead}</p>
            <p>{g.buying.note}</p>
          </div>
          <div class="gstep">
            <div class="gstep__head"><span class="mono">02</span><h3>Installing it</h3></div>
            <Effort level={g.install.effort} label="Effort" />
            <p><strong>Time:</strong> {g.install.time}</p>
            <p><strong>You'll need:</strong> {g.install.tools.join(' · ')}</p>
            <p>{g.install.note}</p>
          </div>
          <div class="gstep">
            <div class="gstep__head"><span class="mono">03</span><h3>Living with it</h3></div>
            <Effort level={g.ongoing.effort} label="Effort" />
            <p>{g.ongoing.note}</p>
          </div>
        </div>

        <div class="gsec">
          <h3>If not this, then what</h3>
          <ul class="galt">
            {g.alternatives.map((a: any) => (<li><strong>{a.name}</strong><span>{a.note}</span></li>))}
          </ul>
        </div>

        <div class="gverdict">
          <span class="eyebrow">Our verdict</span>
          <p>{g.verdict}</p>
          <p class="gfine">We don't take payment for placement and we don't sell these products. If you think we've got something wrong here, tell us — <a href="/about/#contact">we'll correct it</a>.</p>
        </div>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section section--tight">
      <div class="wrap">
        <div class="section-head"><h2>Also in {cat.short}</h2></div>
        <div class="grid grid--3">{related.map((r) => <ProductCard product={r} />)}</div>
      </div>
    </section>
  )}
</Base>
<style>
  .prod { padding-block: clamp(2rem, 5vw, 4rem) 1rem; }
  .crumb { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3); margin-bottom: 1.5rem; }
  .crumb a { color: inherit; text-decoration: none; }
  .prod__grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .prod__pick { font-family: var(--mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--zone); font-weight: 500; }
  .prod__name { font-size: clamp(1.9rem, 3.8vw, 2.9rem); margin-top: 0.5rem; }
  .prod__meta { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; font-size: 0.78rem; color: var(--ink-3); margin-top: 0.9rem; }
  .prod__meta em { font-style: normal; color: var(--ink-3); }
  .prod__sum { font-size: 1.15rem; margin-top: 1.5rem; }
  .prod__pc { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 2.25rem; padding-top: 1.5rem; border-top: 2px solid var(--ink); }
  .prod__h { font-size: 1.1rem; color: var(--zone); margin-bottom: 0.5rem; }
  .prod__h--con { color: var(--ink-2); }
  .prod__pc ul { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.4rem; font-size: 0.97rem; }
  .prod__best { margin-top: 2rem; padding: 1rem 1.25rem; background: var(--surface); border-left: 4px solid var(--zone); }
  .prod__best p { margin-top: 0.25rem; font-weight: 500; }
  .prod__buy { position: sticky; top: 1rem; background: var(--surface); border: 1px solid var(--line); padding: 0 1.25rem 1.25rem; display: grid; gap: 1rem; }
  .prod__buy > :global(.pimg) { margin: 0 -1.25rem 0.25rem; }
  .buy__links { display: grid; gap: 0.5rem; }
  .buy__links .btn { justify-content: center; text-align: center; }
  .buy__fine { font-size: 0.8rem; color: var(--ink-3); max-width: none; }
  .buy__fine a { color: var(--ink-2); }
  .buy__cat { border-top: 1px solid var(--line); padding-top: 1rem; display: grid; gap: 0.3rem; }
  .buy__cat > a { font-family: var(--display); font-weight: 600; font-size: 1.02rem; text-decoration: none; }
  .buy__cat p { font-size: 0.88rem; color: var(--ink-2); }

  .prod__jump { display: inline-block; margin-top: 1.5rem; font-weight: 500; font-size: 0.97rem; text-decoration: none; border-bottom: 2px solid var(--zone); padding-bottom: 2px; }
  .guide { padding-block: clamp(2.5rem, 6vw, 4.5rem); background: var(--bg-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); margin-top: clamp(2rem, 5vw, 3.5rem); }
  .guide .section-head p { max-width: 62ch; }
  .atglance { display: grid; grid-template-columns: 1.1fr 1fr; gap: 0; border: 1px solid var(--line); background: var(--surface); margin-bottom: clamp(2rem, 4vw, 3rem); }
  .atglance__efforts { display: grid; gap: 1.25rem; padding: 1.5rem; align-content: start; }
  .atglance__cost { display: grid; gap: 0.2rem; padding: 1.5rem; border-left: 1px solid var(--line); align-content: start; }
  .atglance__cost p { font-size: 0.95rem; margin-bottom: 0.85rem; max-width: none; }
  .atglance__cost p:last-child { margin-bottom: 0; }
  .atglance :global(.eff__lab) { font-family: var(--mono); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.11em; color: var(--ink-3); }
  .eff__lab { font-family: var(--mono); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.11em; color: var(--ink-3); }
  @media (max-width: 700px) { .atglance { grid-template-columns: 1fr; } .atglance__cost { border-left: 0; border-top: 1px solid var(--line); } }

  .gsec { max-width: 74ch; margin-bottom: clamp(1.75rem, 4vw, 2.75rem); }
  .gsec h3 { font-size: clamp(1.15rem, 2.2vw, 1.4rem); color: var(--zone); margin-bottom: 0.6rem; padding-top: 1.1rem; border-top: 2px solid var(--ink); }
  .gsec > p { color: var(--ink-2); }
  .gspec { display: grid; grid-template-columns: minmax(150px, 12rem) 1fr; gap: 0; margin: 0.75rem 0 0; }
  .gspec dt { font-weight: 600; padding: 0.7rem 1rem 0.7rem 0; border-top: 1px solid var(--line); font-size: 0.95rem; }
  .gspec dd { margin: 0; padding: 0.7rem 0; border-top: 1px solid var(--line); color: var(--ink-2); font-size: 0.95rem; }
  @media (max-width: 620px) { .gspec { grid-template-columns: 1fr; } .gspec dd { border-top: 0; padding-top: 0; } }
  .gfine { font-size: 0.82rem; color: var(--ink-3); margin-top: 1rem; }
  .gfine a { color: var(--ink-2); }

  .gsteps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border: 1px solid var(--line); background: var(--surface); margin-bottom: clamp(1.75rem, 4vw, 2.75rem); }
  .gstep { padding: 1.5rem; display: grid; gap: 0.85rem; align-content: start; border-top: 6px solid var(--zone); }
  .gstep + .gstep { border-left: 1px solid var(--line); }
  .gstep__head { display: flex; align-items: baseline; gap: 0.75rem; }
  .gstep__head .mono { font-size: 0.72rem; color: var(--ink-3); }
  .gstep h3 { font-size: 1.15rem; }
  .gstep p { font-size: 0.93rem; color: var(--ink-2); max-width: none; }
  .gstep strong { color: var(--ink); }
  @media (max-width: 900px) { .gsteps { grid-template-columns: 1fr; } .gstep + .gstep { border-left: 0; } }

  .galt { list-style: none; margin: 0.75rem 0 0; padding: 0; display: grid; gap: 0; }
  .galt li { display: grid; gap: 0.2rem; padding: 0.85rem 0; border-top: 1px solid var(--line); }
  .galt strong { font-size: 0.98rem; }
  .galt span { color: var(--ink-2); font-size: 0.95rem; }
  .gverdict { max-width: 74ch; padding: 1.5rem; background: var(--surface); border-left: 4px solid var(--zone); }
  .gverdict > p { margin-top: 0.4rem; font-size: 1.05rem; }
  @media (max-width: 820px) { .prod__grid { grid-template-columns: 1fr; } .prod__buy { position: static; } }
  @media (max-width: 560px) { .prod__pc { grid-template-columns: 1fr; } }
</style>
