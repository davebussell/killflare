---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductImage from '../../components/ProductImage.astro';
import categories from '../../data/categories.json';
import products from '../../data/products.json';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const cat = categories.find((c) => c.slug === p.category)!;
const related = products.filter((x) => x.category === p.category && x.slug !== p.slug).slice(0, 3);
const regionNames = p.region.map((r: string) => (r === 'CA' ? 'Canada' : 'United States')).join(' & ');
const affiliate = p.links.filter((l: any) => l.kind === 'affiliate');
const direct = p.links.filter((l: any) => l.kind === 'direct');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  brand: { '@type': 'Brand', name: p.brand },
  description: p.summary,
  category: cat.name,
};
---
<Base title={p.name} description={`${p.pick}: ${p.summary}`} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class={`prod zone-${cat.zone}`}>
    <div class="wrap">
      <nav class="crumb mono" aria-label="Breadcrumb"><a href="/categories/">Gear</a> / <a href={`/categories/${cat.slug}/`}>{cat.short}</a></nav>
      <div class="prod__grid">
        <div class="prod__main">
          <span class="prod__pick">{p.pick}</span>
          <h1 class="prod__name">{p.name}</h1>
          <div class="prod__meta mono">
            <span>{p.brand}</span>
            <span>{regionNames}</span>
            <span title={p.priceNote}>{p.priceBand} <em>· {p.priceNote}</em></span>
          </div>
          <p class="prod__sum">{p.summary}</p>

          <div class="prod__pc">
            <div>
              <h2 class="prod__h">Why we like it</h2>
              <ul>{p.pros.map((x: string) => <li>{x}</li>)}</ul>
            </div>
            <div>
              <h2 class="prod__h prod__h--con">Watch out for</h2>
              <ul>{p.cons.map((x: string) => <li>{x}</li>)}</ul>
            </div>
          </div>

          <div class="prod__best">
            <span class="eyebrow">Best for</span>
            <p>{p.bestFor}</p>
          </div>
        </div>

        <aside class="prod__buy">
          <ProductImage product={p} ratio="4 / 3" size={72} eager={true} />
          <span class="eyebrow">Where to buy</span>
          <div class="buy__links">
            {affiliate.map((l: any) => <a href={l.url} class="btn btn--ember" rel="sponsored noopener" target="_blank">{l.label}</a>)}
            {direct.map((l: any) => <a href={l.url} class="btn btn--ghost" rel="noopener" target="_blank">{l.label}</a>)}
          </div>
          <p class="buy__fine">Prices change daily and vary by region, so we show a price band rather than a number. Affiliate links earn us a small commission at no cost to you. <a href="/about/#disclosure">How we make money.</a></p>
          <div class="buy__cat">
            <span class="eyebrow">Category</span>
            <a href={`/categories/${cat.slug}/`}>{cat.name} →</a>
            <p>{cat.tagline}</p>
          </div>
        </aside>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section section--tight">
      <div class="wrap">
        <div class="section-head"><h2>Also in {cat.short}</h2></div>
        <div class="grid grid--3">{related.map((r) => <ProductCard product={r} />)}</div>
      </div>
    </section>
  )}
</Base>
<style>
  .prod { padding-block: clamp(2rem, 5vw, 4rem) 1rem; }
  .crumb { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3); margin-bottom: 1.5rem; }
  .crumb a { color: inherit; text-decoration: none; }
  .prod__grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .prod__pick { font-family: var(--mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--zone); font-weight: 500; }
  .prod__name { font-size: clamp(2.25rem, 5vw, 3.75rem); text-transform: none; margin-top: 0.5rem; }
  .prod__meta { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; font-size: 0.78rem; color: var(--ink-3); margin-top: 0.9rem; }
  .prod__meta em { font-style: normal; color: var(--ink-3); }
  .prod__sum { font-size: 1.15rem; margin-top: 1.5rem; }
  .prod__pc { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 2.25rem; padding-top: 1.5rem; border-top: 2px solid var(--ink); }
  .prod__h { font-size: 1.35rem; text-transform: uppercase; color: var(--zone); margin-bottom: 0.5rem; }
  .prod__h--con { color: var(--ink-2); }
  .prod__pc ul { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.4rem; font-size: 0.97rem; }
  .prod__best { margin-top: 2rem; padding: 1rem 1.25rem; background: var(--surface); border-left: 4px solid var(--zone); }
  .prod__best p { margin-top: 0.25rem; font-weight: 500; }
  .prod__buy { position: sticky; top: 1rem; background: var(--surface); border: 1px solid var(--line); padding: 0 1.25rem 1.25rem; display: grid; gap: 1rem; }
  .prod__buy > :global(.pimg) { margin: 0 -1.25rem 0.25rem; }
  .buy__links { display: grid; gap: 0.5rem; }
  .buy__links .btn { justify-content: center; text-align: center; }
  .buy__fine { font-size: 0.8rem; color: var(--ink-3); max-width: none; }
  .buy__fine a { color: var(--ink-2); }
  .buy__cat { border-top: 1px solid var(--line); padding-top: 1rem; display: grid; gap: 0.3rem; }
  .buy__cat > a { font-family: var(--display); font-weight: 600; font-size: 1.2rem; text-decoration: none; }
  .buy__cat p { font-size: 0.88rem; color: var(--ink-2); }
  @media (max-width: 820px) { .prod__grid { grid-template-columns: 1fr; } .prod__buy { position: static; } }
  @media (max-width: 560px) { .prod__pc { grid-template-columns: 1fr; } }
</style>
