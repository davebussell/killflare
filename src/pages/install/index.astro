---
import Base from '../../layouts/Base.astro';
import installers from '../../data/installers.json';
import regions from '../../data/regions.json';

const { companies, programs } = installers;
const byProvince = regions.map((r) => ({
  code: r.code,
  name: r.name,
  slug: r.slug,
  progs: programs.filter((p: any) => p.province === r.code),
  cos: companies.filter((c: any) => c.provinces.includes(r.code)),
}));
const installersOnly = companies.filter((c: any) => c.services.includes('install'));
const nonInstall = companies.filter((c: any) => !c.services.includes('install'));
---
<Base title="Find an installer" description="Verified wildfire mitigation installers, equipment suppliers and free provincial FireSmart home assessment programs across Canada.">
  <section class="section">
    <div class="wrap">
      <span class="eyebrow eyebrow--ember">Install</span>
      <h1>Get it done properly</h1>
      <p class="lede">Most of what protects a house from wildfire can be installed by a competent homeowner in a weekend. Some of it — permanent roof sprinkler systems, pump and tank plumbing, full vent replacement — is worth paying for. This page lists the companies we have been able to verify, and the official programs that will assess your property for free.</p>

      <div class="notice">
        <p><strong>How this list works.</strong> Every company here was checked against its own website in September 2026, and we say plainly what each one does and does not do. We do not accept payment for placement and we earn nothing from these listings. Canada's homeowner wildfire-installation sector is small and concentrated in BC and Alberta — where we could not verify anyone serving a province, we say so rather than padding the list.</p>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="section-head"><h2>Start here: free assessments</h2><p>Several provinces will send a certified professional at no cost.</p></div>
      <p class="intro">Before hiring anyone, find out whether your province or regional district will assess your property for free. British Columbia's Wildfire Mitigation Program does exactly that, Yukon offers territorial assessments, and many BC regional districts and Alberta municipalities run rebate programs that reimburse qualifying work. This is the cheapest expert opinion you will ever get on your own house.</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="section-head"><h2>Installers</h2><p>Companies that will design and fit a system on your home.</p></div>
      <div class="grid grid--2">
        {installersOnly.map((c: any) => (
          <article class="card co">
            <div class="co__top">
              <span class="co__type mono">{c.type}</span>
              <span class="co__prov mono">{c.provinces.join(' · ')}</span>
            </div>
            <h3>{c.name}</h3>
            <p class="co__sum">{c.summary}</p>
            <dl class="co__meta mono">
              <div><dt>Price</dt><dd>{c.priceNote}</dd></div>
              <div><dt>Contact</dt><dd>{c.contact}</dd></div>
            </dl>
            <p class="co__verified mono">{c.verified}</p>
            <a href={c.url} class="btn btn--ember co__cta" rel="noopener nofollow" target="_blank">Visit {c.name} ↗</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="section-head"><h2>Equipment, consulting and community-scale</h2><p>Supply and larger projects rather than home installation.</p></div>
      <div class="grid grid--2">
        {nonInstall.map((c: any) => (
          <article class="card co co--alt">
            <div class="co__top">
              <span class="co__type mono">{c.type}</span>
              <span class="co__prov mono">{c.provinces.length > 6 ? 'Canada-wide' : c.provinces.join(' · ')}</span>
            </div>
            <h3>{c.name}</h3>
            <p class="co__sum">{c.summary}</p>
            <p class="co__verified mono">{c.verified}</p>
            <a href={c.url} class="btn btn--ghost co__cta" rel="noopener nofollow" target="_blank">Visit {c.name} ↗</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="section-head"><h2>By province and territory</h2></div>
      <div class="provs">
        {byProvince.map((p) => (
          <div class="prov" id={p.code.toLowerCase()}>
            <div class="prov__head">
              <span class="prov__code mono">{p.code}</span>
              <h3><a href={`/regions/${p.slug}/`}>{p.name}</a></h3>
            </div>
            {p.progs.length > 0 && (
              <ul class="prov__list">
                {p.progs.map((pr: any) => (
                  <li><a href={pr.url} rel="noopener" target="_blank">{pr.name} ↗</a><span>{pr.note}</span></li>
                ))}
              </ul>
            )}
            <p class="prov__cos mono">
              {p.cos.filter((c: any) => c.services.includes('install')).length > 0
                ? `Installers serving ${p.code}: ${p.cos.filter((c: any) => c.services.includes('install')).map((c: any) => c.name).join(', ')}`
                : `No home-installation company verified for ${p.code}. National suppliers ship here.`}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="listing">
        <div>
          <h2>Install this kind of work?</h2>
          <p>If you fit exterior sprinkler systems, replace vents to WUI standard, do FireSmart vegetation work or run certified home assessments, tell us and we will verify and list you. Listing is free and we do not sell placement.</p>
        </div>
        <form name="installer-listing" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="lform">
          <input type="hidden" name="form-name" value="installer-listing" />
          <p class="hidden"><label>Leave this empty: <input name="bot-field" /></label></p>
          <label>Company name<input type="text" name="company" required /></label>
          <label>Website<input type="url" name="website" placeholder="https://" required /></label>
          <label>Email<input type="email" name="email" required /></label>
          <label>Provinces served<input type="text" name="provinces" placeholder="BC, AB" required /></label>
          <label>What do you do?<textarea name="services" rows="3" placeholder="Exterior sprinkler installation, WUI vent replacement, FireSmart vegetation work…" required></textarea></label>
          <button type="submit" class="btn btn--ember">Submit for review</button>
        </form>
      </div>
    </div>
  </section>
</Base>
<style>
  .lede { color: var(--ink-2); margin: 0.75rem 0 1.5rem; font-size: 1.1rem; }
  .intro { font-size: 1.05rem; color: var(--ink-2); }

  .co { padding: 1.25rem; gap: 0.5rem; border-top: 4px solid var(--ember); }
  .co--alt { border-top-color: var(--water); }
  .co__top { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .co__type { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ember); font-weight: 500; }
  .co--alt .co__type { color: var(--water); }
  .co__prov { font-size: 0.7rem; color: var(--ink-3); letter-spacing: 0.08em; }
  .co h3 { text-transform: none; }
  .co__sum { font-size: 0.95rem; color: var(--ink-2); }
  .co__meta { display: grid; gap: 0.2rem; font-size: 0.76rem; margin-top: 0.4rem; }
  .co__meta div { display: grid; grid-template-columns: 4.5rem 1fr; gap: 0.6rem; border-top: 1px solid var(--line); padding-top: 0.3rem; }
  .co__meta dt { color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.06em; }
  .co__meta dd { margin: 0; }
  .co__verified { font-size: 0.68rem; color: var(--ink-3); margin-top: 0.5rem; }
  .co__cta { margin-top: auto; align-self: start; }

  .provs { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.25rem; }
  .prov { border: 1px solid var(--line); background: var(--surface); padding: 1rem 1.1rem; scroll-margin-top: 1rem; }
  .prov__head { display: flex; align-items: baseline; gap: 0.6rem; border-bottom: 1px solid var(--line); padding-bottom: 0.5rem; }
  .prov__code { font-size: 0.72rem; color: var(--ember); letter-spacing: 0.15em; font-weight: 500; }
  .prov__head h3 { font-size: 1.25rem; text-transform: none; }
  .prov__head a { text-decoration: none; }
  .prov__list { list-style: none; margin: 0.7rem 0 0; padding: 0; display: grid; gap: 0.6rem; }
  .prov__list a { font-size: 0.9rem; font-weight: 500; color: var(--ink); text-decoration: none; display: block; }
  .prov__list a:hover { color: var(--ember); }
  .prov__list span { font-size: 0.82rem; color: var(--ink-3); display: block; margin-top: 0.15rem; }
  .prov__cos { margin-top: 0.8rem; padding-top: 0.6rem; border-top: 1px solid var(--line); font-size: 0.72rem; color: var(--ink-3); }

  .listing { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); background: var(--surface); border: 1px solid var(--line); border-top: 4px solid var(--moss); padding: clamp(1.25rem, 3vw, 2rem); align-items: start; }
  .listing h2 { text-transform: none; font-size: clamp(1.5rem, 3vw, 2rem); }
  .listing p { color: var(--ink-2); margin-top: 0.6rem; font-size: 0.97rem; }
  .lform { display: grid; gap: 0.7rem; }
  .lform label { display: grid; gap: 0.25rem; font-size: 0.82rem; font-weight: 500; }
  .lform input, .lform textarea {
    font: inherit; font-size: 0.92rem; padding: 0.5rem 0.6rem;
    border: 1px solid var(--line); background: var(--bg); color: var(--ink); border-radius: 0;
  }
  .lform input:focus-visible, .lform textarea:focus-visible { outline: 3px solid var(--amber); outline-offset: 1px; }
  .lform button { justify-self: start; margin-top: 0.3rem; cursor: pointer; }
  .hidden { display: none; }
  @media (max-width: 820px) { .listing { grid-template-columns: 1fr; } }
</style>
