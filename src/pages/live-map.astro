---
import Base from '../layouts/Base.astro';
---
<Base
  title="Live wildfire map: Canada and US hotspots"
  description="Satellite-detected wildfire hotspots across Canada and the US from the last 24 hours, from the Canadian Wildland Fire Information System. Updated several times a day."
>
  <section class="section section--tight">
    <div class="wrap">
      <span class="eyebrow eyebrow--ember">Live</span>
      <h1>Active fire map</h1>
      <p class="lede">
        Satellite fire detections across Canada and the US from the last 24 hours. This is raw detection data, not
        an official warning. For evacuation orders and confirmed incidents, use your provincial or state alert
        system, <a href="https://inciweb.wildfire.gov/" rel="noopener" target="_blank">InciWeb</a> (US) or
        <a href="https://cwfis.cfs.nrcan.gc.ca/interactive-map" rel="noopener" target="_blank">the CWFIS interactive map</a> (Canada).
      </p>

      <div id="fire-map" class="fire-map" role="application" aria-label="Map of wildfire hotspots detected in the last 24 hours">
        <p class="fire-map__loading mono">Loading map…</p>
      </div>

      <div class="fire-map__bar">
        <ul class="fire-map__legend mono" aria-label="Legend">
          <li><span class="dot dot--0"></span>Lower intensity</li>
          <li><span class="dot dot--1"></span>Moderate</li>
          <li><span class="dot dot--2"></span>High</li>
        </ul>
        <p class="fire-map__meta mono" id="fire-map-meta-text">Loading…</p>
      </div>

      <div class="notice">
        <p><strong>How to read this:</strong> each dot is one satellite thermal detection (VIIRS, MODIS and similar sensors), not a fire perimeter or a confirmed structure fire. A single wildfire usually shows as a cluster of dots, and fires can be missed between satellite passes or under cloud. Dot colour is the estimated head-fire intensity at that spot, a rough guide to how hard it was burning, not to danger to any particular home. Some dots are prescribed burns, crop-residue burning or industrial heat sources.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .lede { color: var(--ink-2); margin: 0.75rem 0 1.75rem; font-size: 1.1rem; max-width: var(--measure); }
  .fire-map {
    position: relative; width: 100%; aspect-ratio: 16 / 10; max-height: 720px;
    background: var(--surface); border: 1px solid var(--line); border-radius: 4px; overflow: hidden;
  }
  @media (max-width: 640px) { .fire-map { aspect-ratio: 4 / 5; } }
  .fire-map__loading {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    color: var(--ink-3); font-size: 0.85rem; letter-spacing: 0.03em; margin: 0;
  }
  .fire-map__bar { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.4rem 1.5rem; margin: 0.7rem 0 1.5rem; }
  .fire-map__legend { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; font-size: 0.75rem; color: var(--ink-2); }
  .fire-map__legend li { display: flex; align-items: center; gap: 0.4rem; }
  .dot { width: 0.7rem; height: 0.7rem; border-radius: 50%; border: 1px solid #fff; box-shadow: 0 0 0 1px var(--line); }
  .dot--0 { background: #e8a21a; } .dot--1 { background: #d8460d; } .dot--2 { background: #8a1a06; }
  .fire-map__meta { margin: 0; font-size: 0.75rem; color: var(--ink-3); }
  :global(.fire-popup) { font-family: var(--body); font-size: 0.85rem; line-height: 1.4; margin: 0; color: #1a1d1b; }
  :global(.fire-popup dt) { font-weight: 600; color: #4a4f4c; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.35rem; }
  :global(.fire-popup dt:first-child) { margin-top: 0; }
  :global(.fire-popup dd) { margin: 0; }
  @media (max-width: 640px) {
    .fire-map :global(.maplibregl-ctrl-attrib) { font-size: 10px; }
  }
</style>

<script>
  import { Map as MapLibreMap, NavigationControl, AttributionControl, Popup, setWorkerUrl } from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';
  // MapLibre loads its web worker from a file next to its own module. Once Vite
  // bundles the library that file no longer exists, so the worker failed and
  // nothing but the hillshade drew (no roads, labels or fire dots). Bundle the
  // worker explicitly and point MapLibre at it.
  import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url';
  setWorkerUrl(workerUrl);

  // Fresh data lives on the `live-data` branch (refreshed by
  // .github/workflows/refresh-live-data.yml). The copy baked into the build at
  // /live/ is only a fallback if GitHub is unreachable.
  const LIVE = 'https://raw.githubusercontent.com/davebussell/killflare/live-data';
  async function getJSON(file: string) {
    try {
      const r = await fetch(`${LIVE}/${file}`, { cache: 'no-store' });
      if (r.ok) return await r.json();
    } catch {}
    const r = await fetch(`/live/${file}`, { cache: 'no-store' });
    return r.json();
  }

  const fmtTime = (iso: string) =>
    new Date(iso).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZoneName: 'short' });
  const LEVELS = ['Lower intensity', 'Moderate intensity', 'High intensity'];
  const esc = (v: unknown) => String(v).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  function initMap() {
    const container = document.getElementById('fire-map');
    if (!container) return;
    const small = window.matchMedia('(max-width: 640px)').matches;

    // OpenFreeMap: free, no API key, no usage limits (https://openfreemap.org).
    const map = new MapLibreMap({
      container,
      style: 'https://tiles.openfreemap.org/styles/liberty',
      center: small ? [-100, 50] : [-100, 47],
      zoom: small ? 1.6 : 2.6,
      attributionControl: false,
      cooperativeGestures: small,
    });
    map.addControl(new AttributionControl({ compact: true }), 'bottom-right');
    map.addControl(new NavigationControl({ showCompass: false }), 'top-right');

    getJSON('meta.json')
      .then((meta) => {
        const el = document.getElementById('fire-map-meta-text');
        if (!el) return;
        if (!meta?.generatedAt) { el.textContent = 'Waiting for the first data refresh.'; return; }
        const c = meta.counts || {};
        el.textContent = c.total
          ? `${c.total.toLocaleString()} detections · ${c.canada ?? 0} Canada, ${c.us ?? 0} US · updated ${fmtTime(meta.generatedAt)}`
          : `No detections in the last 24 hours · checked ${fmtTime(meta.generatedAt)}`;
      })
      .catch(() => {
        const el = document.getElementById('fire-map-meta-text');
        if (el) el.textContent = 'Could not load refresh status.';
      });

    map.on('load', async () => {
      // Start the attribution collapsed to its (i) button on small screens.
      if (small) container.querySelector('.maplibregl-ctrl-attrib')?.classList.remove('maplibregl-compact-show');
      const loading = container.querySelector('.fire-map__loading');
      try {
        const data = await getJSON('fires.geojson');
        map.addSource('fires', { type: 'geojson', data });
        map.addLayer({
          id: 'fires-points',
          type: 'circle',
          source: 'fires',
          paint: {
            'circle-radius': ['interpolate', ['linear'], ['zoom'], 1.5, 2.5, 5, 4, 9, 8],
            'circle-color': ['match', ['coalesce', ['get', 'level'], 0], 2, '#8a1a06', 1, '#d8460d', '#e8a21a'],
            'circle-stroke-width': 0.75,
            'circle-stroke-color': '#ffffff',
            'circle-opacity': 0.9,
          },
        });

        map.on('click', 'fires-points', (e) => {
          const f = e.features && e.features[0];
          if (!f) return;
          const p = f.properties as Record<string, any>;
          const rows: [string, unknown][] = [
            ['Where', p.agency ? `${p.agency} · ${p.country === 'CA' ? 'Canada' : 'US'}` : (p.country === 'CA' ? 'Canada' : 'US')],
            ['Detected', p.detected ? fmtTime(p.detected) : null],
            ['Intensity', LEVELS[p.level ?? 0] + (p.intensity != null && p.intensity !== 'null' ? ` (${Math.round(p.intensity).toLocaleString()} kW/m)` : '')],
            ['Sensor', p.sensor],
            ['Source', p.source === 'cwfis' ? 'CWFIS / Natural Resources Canada' : 'NASA FIRMS'],
          ].filter(([, v]) => v !== undefined && v !== null && v !== '' && v !== 'null');
          const html = `<dl class="fire-popup">${rows.map(([k, v]) => `<dt>${k}</dt><dd>${esc(v)}</dd>`).join('')}</dl>`;
          new Popup({ closeButton: true, maxWidth: '260px' }).setLngLat(e.lngLat).setHTML(html).addTo(map);
        });
        map.on('mouseenter', 'fires-points', () => { map.getCanvas().style.cursor = 'pointer'; });
        map.on('mouseleave', 'fires-points', () => { map.getCanvas().style.cursor = ''; });
      } catch (err) {
        console.error('Failed to load fire data', err);
      } finally {
        loading?.remove();
      }
    });
  }

  initMap();
</script>
