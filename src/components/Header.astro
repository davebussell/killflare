---
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const nav = [
  { href: '/categories/', label: 'Gear' },
  { href: '/guides/', label: 'Guides' },
  { href: '/start-here/', label: 'Start Here' },
  { href: '/about/', label: 'About' },
];
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a href="/" class="hdr__brand" aria-label="Killflare home"><Logo /></a>
    <nav class="hdr__nav" aria-label="Primary">
      {nav.map((n) => (
        <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
  </div>
  <div class="hdr__strip" role="note">
    <div class="wrap">Reader-supported. Some links are affiliate links — see our <a href="/about/#disclosure">disclosure</a>. Evacuate when ordered; no product replaces leaving early.</div>
  </div>
</header>

<style>
  .hdr { background: var(--char); color: var(--char-ink); }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 0.9rem; }
  .hdr__brand { display: block; color: inherit; text-decoration: none; }
  .hdr__nav { display: flex; gap: clamp(0.75rem, 2.5vw, 1.75rem); }
  .hdr__nav a {
    font-family: var(--display); font-weight: 600; font-size: 1.15rem; text-transform: uppercase; letter-spacing: 0.05em;
    text-decoration: none; color: var(--char-ink-2); padding-block: 0.25rem; border-bottom: 2px solid transparent;
  }
  .hdr__nav a:hover, .hdr__nav a[aria-current='page'] { color: var(--char-ink); border-bottom-color: var(--ember); }
  .hdr__strip { background: var(--ember); color: #fff; font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.03em; padding-block: 0.4rem; }
  .hdr__strip a { color: inherit; }
  @media (max-width: 560px) { .hdr__nav a { font-size: 1rem; } }
</style>
