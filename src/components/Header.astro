---
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const nav = [
  { href: '/home-safety/', label: 'Home' },
  { href: '/business/', label: 'Business' },
  { href: '/wildfire/', label: 'Wildfire' },
  { href: '/contractors/', label: 'Contractors' },
  { href: '/guides/', label: 'Guides' },
  { href: '/live-map/', label: 'Live map' },
  { href: '/about/', label: 'About' },
];
// Category, product and region pages light up the pillar they belong to.
const pillarOf = (Astro.props as any).pillar as string | undefined;
const active = (href: string) =>
  path.startsWith(href) ||
  (pillarOf === 'home' && href === '/home-safety/') ||
  (pillarOf === 'business' && href === '/business/') ||
  (pillarOf === 'wildfire' && href === '/wildfire/') ||
  (path.startsWith('/regions/') && href === '/wildfire/');
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a href="/" class="hdr__brand" aria-label="Killflare home"><Logo /></a>
    <nav class="hdr__nav" aria-label="Primary">
      {nav.map((n) => (
        <a href={n.href} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
  </div>
  <div class="hdr__strip" role="note">
    <div class="wrap">Independent and reader-supported. Some links are affiliate links — see our <a href="/about/#disclosure">disclosure</a>. Codes vary by province, state and city: confirm with your local fire authority.</div>
  </div>
</header>

<style>
  .hdr { background: var(--char); color: var(--char-ink); }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 0.9rem; }
  .hdr__brand { display: block; color: inherit; text-decoration: none; }
  .hdr__nav { display: flex; flex-wrap: wrap; gap: 0.35rem clamp(0.7rem, 2.2vw, 1.5rem); justify-content: flex-end; }
  .hdr__nav a {
    font-family: var(--display); font-weight: 600; font-size: 0.95rem; letter-spacing: -0.008em;
    text-decoration: none; color: var(--char-ink-2); padding-block: 0.25rem; border-bottom: 2px solid transparent;
  }
  .hdr__nav a:hover, .hdr__nav a[aria-current='page'] { color: var(--char-ink); border-bottom-color: var(--ember); }
  .hdr__strip { background: var(--ember); color: #fff; font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.03em; padding-block: 0.4rem; }
  .hdr__strip a { color: inherit; }
  @media (max-width: 560px) { .hdr__nav a { font-size: 0.92rem; } }
  @media (max-width: 620px) {
    .hdr__in { flex-wrap: wrap; gap: 0.4rem 1rem; }
    .hdr__nav { width: 100%; justify-content: flex-start; gap: 0.3rem 1rem; }
    .hdr__nav a { font-size: 0.9rem; padding-block: 0.15rem; }
  }
</style>
