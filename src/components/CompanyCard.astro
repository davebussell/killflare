---
import { SERVICE_SHORT, regionByKey } from '../lib/contractors';
interface Props { co: any; highlight?: string }
const { co, highlight } = Astro.props;
const where = co.metro ? `${co.metro}, ${regionByKey(co.regions[0])?.code}` : co.regions.map((r: string) => r.split('-')[1]).join(' · ');
const host = (() => { try { return new URL(co.url).hostname.replace(/^www\./, ''); } catch { return co.url; } })();
---
<article class="co">
  <div class="co__top mono"><span>{where}</span><span>{co.audience.map((a: string) => (a === 'home' ? 'Homes' : 'Businesses')).join(' · ')}</span></div>
  <h3><a href={co.url} rel="noopener nofollow" target="_blank">{co.name}</a></h3>
  <ul class="co__svc">
    {co.services.map((s: string) => <li class={s === highlight ? 'is-hl' : ''}><a href={`/contractors/${s}/`}>{SERVICE_SHORT[s] ?? s}</a></li>)}
  </ul>
  <p class="co__sum">{co.summary}</p>
  {co.credentials && <p class="co__cred"><span class="mono">Credentials stated</span> {co.credentials}</p>}
  {co.note && <p class="co__cred"><span class="mono">Pricing</span> {co.note}</p>}
  <p class="co__foot mono">{co.phone && <span>{co.phone}</span>}<a href={co.url} rel="noopener nofollow" target="_blank">{host} ↗</a></p>
</article>
<style>
  .co { background: var(--surface); border: 1px solid var(--line); border-top: 3px solid var(--ember); padding: 1.1rem 1.2rem; display: grid; gap: 0.55rem; align-content: start; min-width: 0; }
  .co__top { display: flex; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); }
  .co h3 { font-size: 1.08rem; line-height: 1.25; text-transform: none; }
  .co h3 a { text-decoration: none; color: var(--ink); }
  .co h3 a:hover { color: var(--ember); }
  .co__svc { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .co__svc a { display: inline-block; font-size: 0.72rem; padding: 0.12rem 0.45rem; border: 1px solid var(--line); border-radius: 2px; text-decoration: none; color: var(--ink-2); }
  .co__svc .is-hl a { border-color: var(--ember); color: var(--ember); font-weight: 600; }
  .co__sum { font-size: 0.9rem; color: var(--ink-2); }
  .co__cred { font-size: 0.82rem; color: var(--ink-2); }
  .co__cred .mono { font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3); margin-right: 0.3rem; }
  .co__foot { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; font-size: 0.75rem; color: var(--ink-3); margin-top: 0.2rem; overflow-wrap: anywhere; }
  .co__foot a { color: var(--ember); }
</style>
